<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Diplomas</title>
  <style>
    @media print {
      .page-break { page-break-after: always; }
    }
    @media print {
  @page {
    size: letter landscape;
    margin: 0;
  }

  body {
    margin: 0;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .page-break {
    page-break-after: always;
  }
}

  </style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>

<div id="diplomas-container">
  <% participantes.forEach((nombre, i) => { %>

    <%- include("diploma", {
      participante: nombre,
      empresa,
      sucursalLabel,
      logoEmpresa,
      capacitador,
      fecha
    }) %>

    <% if (i < participantes.length - 1) { %>
      <div class="page-break"></div>
    <% } %>

  <% }) %>
</div>
<script>
window.onload = () => {
  requestAnimationFrame(() => {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');

    document.querySelectorAll('.recipient-name').forEach(el => {
      const style = getComputedStyle(el);

      // 🔒 FORZAMOS ancho real
      const maxWidth = el.getBoundingClientRect().width;

      let size = 55;
      const min = 22;

      while (size > min) {
        ctx.font = `${style.fontStyle} ${style.fontWeight} ${size}px ${style.fontFamily}`;
        const textWidth = ctx.measureText(el.textContent).width;

        if (textWidth <= maxWidth) break;
        size--;
      }

      el.style.fontSize = size + 'px';
    });
  });
};

async function descargarPDF() {
  if (typeof html2canvas === "undefined" || !window.jspdf) {
    alert("No se pudo cargar el generador de PDF.");
    return;
  }

  const container = document.getElementById("diplomas-container");
  if (!container) return;

  const images = Array.from(container.querySelectorAll("img"));
  await Promise.all(images.map(img => {
    if (img.complete) return Promise.resolve();
    return new Promise(resolve => {
      img.onload = resolve;
      img.onerror = resolve;
    });
  }));

  if (document.fonts && document.fonts.ready) {
    await document.fonts.ready;
  }

  const diplomaPages = Array.from(container.querySelectorAll(".diploma-canvas"));
  if (!diplomaPages.length) return;

  const { jsPDF } = window.jspdf;
  const pdf = new jsPDF({ unit: "in", format: "letter", orientation: "landscape" });

  for (let index = 0; index < diplomaPages.length; index++) {
    const page = diplomaPages[index];
    const rect = page.getBoundingClientRect();
    const width = Math.round(rect.width || 1056);
    const height = Math.round(rect.height || 816);

    const canvas = await html2canvas(page, {
      scale: 2,
      useCORS: true,
      allowTaint: true,
      backgroundColor: "#ffffff",
      logging: false,
      width,
      height,
      windowWidth: width,
      windowHeight: height
    });

    const imageData = canvas.toDataURL("image/jpeg", 0.98);
    if (index > 0) pdf.addPage();
    pdf.addImage(imageData, "JPEG", 0, 0, 11, 8.5);
  }

  const filename = `constancias-${new Date().toISOString().slice(0, 10)}.pdf`;
  pdf.save(filename);
}
</script>


</body>
</html>
