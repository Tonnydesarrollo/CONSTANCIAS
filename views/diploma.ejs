<style>
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Montserrat:wght@400;700&family=Playfair+Display:ital,wght@1,600&display=swap');

/* =========================================================
   IMPRESIÓN (LA PARTE CRÍTICA)
========================================================= */
@media print {
  @page {
    size: letter landscape;
    margin: 0;
  }

  /* ❌ NO fijar height aquí */
  html, body {
    margin: 0;
    padding: 0;
  }

  /* Cada diploma empieza en hoja nueva */
  .diploma-canvas {
    width: 11in;
    min-height: 8.5in;
    page-break-before: always;
    break-before: page;
  }

  /* El primero NO crea hoja en blanco */
  .diploma-canvas:first-child {
    page-break-before: auto;
    break-before: auto;
  }

  /* Altura interna real */
  .border-frame {
    min-height: calc(8.5in - 0.5in);
  }

  .no-print {
    display: none !important;
  }
}

/* =========================================================
   UI / TOOLBAR
========================================================= */
.toolbar {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 100;
}

.btn-save {
  background-color: #e74c3c;
  color: white;
  border: none;
  padding: 12px 25px;
  font-size: 16px;
  font-weight: bold;
  border-radius: 4px;
  cursor: pointer;
  box-shadow: 0 4px 15px rgba(0,0,0,0.3);
}

/* =========================================================
   CONTENEDOR DIPLOMA
========================================================= */
.diploma-canvas {
  width: 11in;
  min-height: 8.5in;
  background-color: #fff;
  padding: 0.25in;
  box-sizing: border-box;
  position: relative;
}

/* =========================================================
   MARCO
========================================================= */
.border-frame {
  width: 100%;
  height: 100%;
  border: 6px solid #1a2a3a;
  outline: 2px solid #c0392b;
  outline-offset: -12px;
  padding: 25px 50px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #fff;
}

/* =========================================================
   HEADER
========================================================= */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 180px;
  position: relative;
}

.logo-eg-container {
  width: 450px;
  height: 180px;              /* 🔒 MISMA ALTURA DEL HEADER */
  display: flex;
  align-items: center;
  justify-content: flex-start;
  overflow: hidden;           /* 🔥 CLAVE */
}


.logo-eg-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}
.logo-cliente-img {
  max-width: 250px;
  max-height: 120px;
  object-fit: contain;
}

/* =========================================================
   BLOQUE EMPRESA / SUCURSAL
========================================================= */
.center-info {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 420px;
  max-width: 50%;
  text-align: center;
  line-height: 1.2;
}

.empresa-nombre {
  font-family: 'Cinzel', serif;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #1a2a3a;
  margin-bottom: 10px;
  font-size: clamp(20px, 2.2vw, 30px);
  line-height: 1.15;

  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empresa-separador {
  width: 220px;
  height: 3px;
  background-color: #c0392b;
  margin: 0 auto 10px;
}

.sucursal-label {
  font-family: 'Montserrat', sans-serif;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #555;
}

/* =========================================================
   CONTENIDO CENTRAL
========================================================= */
.title-constancia {
  font-family: 'Cinzel', serif;
  font-size: 60px;
  color: #1a2a3a;
  letter-spacing: 8px;
  margin: 0;
}

.recipient-wrapper {
  width: 90%;          /* 🔒 ancho REAL */
  margin: 10px auto;
  text-align: center;
}

.recipient-name {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  color: #c0392b;

  font-size: 55px;     /* tamaño base */
  line-height: 1.1;

  border-bottom: 2px solid #1a2a3a;
  padding: 5px 15px;

  white-space: nowrap; /* 🔒 UNA sola línea */
}




.course-text {
  width: 90%;
  margin: 5px auto;
  text-align: justify;
  text-align-last: center;
  font-size: 22px;
  line-height: 1.4;
  color: #222;
}

/* =========================================================
   FOOTER / FIRMAS
========================================================= */
.footer-signatures {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  align-items: end;
  margin-top: auto;
}
.sig-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  text-align: center;   /* 👈 CLAVE */
}


.sig-img {
  max-height: 90px;
  display: block;
}

.sig-line {
  width: 280px;
  border-top: 2px solid #1a2a3a;
  margin: 5px 0;
}
</style>

<div class="toolbar no-print">
  <button class="btn-save" onclick="window.print()">🖨️ IMPRIMIR / GUARDAR PDF</button>
</div>

<div class="diploma-canvas">
  <div class="border-frame">

    <div class="header">
      <div class="logo-eg-container">
        <img src="/img/Logo sin fondo 3D HD.png"
             class="logo-eg-img"
             alt="Desarrollo EG">
      </div>

      <div class="center-info">
  <div class="empresa-nombre"><%= empresa.nombre %></div>
  <div class="empresa-separador"></div>
  <div class="sucursal-label"><%= sucursalLabel %></div>
</div>



 <div class="logo-cliente-wrapper">

 <img
  src="<%= logoEmpresa %>"
  class="logo-cliente-img"
  alt="Logo Cliente"
  onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
/>

<div
  style="display:none; font-size:11px; color:red; word-break:break-all; max-width:250px;"
>
  <%= logoEmpresa %>
</div>


  <div class="logo-fallback">
    <%= empresa.nombre %>
  </div>

</div>




    </div>

    <div style="text-align:center; flex-grow:1; display:flex; flex-direction:column; justify-content:center;">
      <p style="margin:0; font-size:16px;">Se otorga la presente</p>
      <h1 class="title-constancia">CONSTANCIA</h1>
      <p style="margin:0; font-size:16px;">a:</p>

      <div class="recipient-wrapper">
  <div class="recipient-name"><%= participante %></div>
</div>


      <p style="font-weight:bold; margin:5px 0; font-size:20px;">
        Por su Participación en el curso:
      </p>

      <div class="course-text">
        Formación organización e Integración de Brigadistas de Protección Civil
        (Primeros auxilios, combate contra incendios, Búsqueda y Rescate, Evacuación).
      </div>

      <div style="margin-top:8px; font-size:18px;">
        Celebrado el día <strong><%= fecha.dia %></strong> de
        <strong><%= fecha.mes %></strong> del
        <strong><%= fecha.anio %></strong>. En el municipio de
          <strong><%= ubicacion.municipio %></strong>,
        <strong><%= ubicacion.estado %></strong> Con una Duracion de <strong>8 horas</strong>.

      </div>
    </div>

    <div class="footer-signatures">
      <div></div>

      <div class="sig-block">
        <% if (capacitador.firmaUrl) { %>
          <img src="<%= capacitador.firmaUrl %>" class="sig-img" alt="Firma Capacitador">
        <% } %>
        <div class="sig-line"></div>
        <strong><%= capacitador.nombre %></strong>
        <div style="font-size:11px;">Instructor Capacitador</div>
      </div>

      <div class="sig-block">
        <img src="https://drive.google.com/thumbnail?id=1dvVupM4hcDxuLGWbasND8VK-kjGq2Kwq" class="sig-img">

        <div class="sig-line"></div>
        <strong>MORELOS ENRIQUE PEREZ PICOS</strong>
        <div style="font-size:10px; color:#c0392b; font-weight:bold;">
          CONSULTOR | IEPC-SIN/CC/0128/2024
        </div>
      </div>
    </div>

  </div>
</div>
