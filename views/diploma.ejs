<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">

  <!-- FUENTES -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Montserrat:wght@400;700&family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet">

  <style>
.recipient-wrapper {
  width: 80%;
  margin: 15px auto;
  display: flex;
  justify-content: center;   /* 🔑 centra visualmente */
  overflow: hidden;
}

.recipient-name {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  color: #c0392b;
  font-size: 55px;
  border-bottom: 2px solid #1a2a3a;
  padding: 5px 15px;
  white-space: nowrap;
  text-transform: uppercase;

  transform-origin: center center;
}

    /* =========================
       RESET SEGURO PARA IMPRESIÓN
       ========================= */
    html, body {
      margin: 0;
      padding: 0;
      background: #fff;
    }

    /* =========================
       HOJA LETTER HORIZONTAL
       ========================= */
    .diploma-canvas {
      width: 11in;
      height: 8.5in;          /* 👈 EXACTO LETTER */
      box-sizing: border-box;
      position: relative;
      overflow: hidden;
      background: #fff;
      display: block;
    }

    /* =========================
       MARCO INSTITUCIONAL
       ========================= */
    .border-frame {
      width: 100%;
      height: 100%;
      border: 6px solid #1a2a3a;
      outline: 2px solid #c0392b;
      outline-offset: -12px;
      padding: 25px 50px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      background: #fff;
    }

    /* =========================
       ENCABEZADO
       ========================= */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 180px;
      position: relative;
    }

    .logo-eg-container {
      width: 450px;
      height: 180px;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      overflow: hidden;
    }

    .logo-eg-img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .logo-cliente-img {
      max-width: 250px;
      max-height: 120px;
      object-fit: contain;
    }

    .center-info {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: 420px;
      text-align: center;
      line-height: 1.2;
    }

    .empresa-nombre {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      color: #1a2a3a;
      font-size: 24px;
      margin-bottom: 10px;
    }

    .empresa-separador {
      width: 220px;
      height: 3px;
      background-color: #c0392b;
      margin: 0 auto 10px;
    }

    .sucursal-label {
      font-size: 20px;
      font-family: 'Montserrat', sans-serif;
    }

    /* =========================
       CUERPO
       ========================= */
    .contenido {
      text-align: center;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .title-constancia {
      font-family: 'Cinzel', serif;
      font-size: 60px;
      color: #1a2a3a;
      letter-spacing: 8px;
      margin: 10px 0;
    }

    .recipient-name {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  color: #c0392b;
  font-size: 55px;
  border-bottom: 2px solid #1a2a3a;
  padding: 5px 15px;
  white-space: nowrap;
  text-transform: uppercase;

  display: block;          /* 🔑 NO inline-block */
  width: max-content;      /* 🔑 ancho real del texto */
  margin: 0 auto;
  transform-origin: center center;
}


    .course-text {
      width: 90%;
      margin: 10px auto;
      text-align: center;
      font-size: 22px;
      line-height: 1.4;
      color: #222;
      font-family: 'Montserrat', sans-serif;
    }

    /* =========================
       FIRMAS
       ========================= */
    .footer-signatures {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      align-items: end;
      margin-top: auto;
    }

    .sig-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .sig-img {
      max-height: 90px;
    }

    .sig-line {
      width: 280px;
      border-top: 2px solid #1a2a3a;
      margin: 5px 0;
    }

    /* =========================
       IMPRESIÓN (CLAVE)
       ========================= */
     @media print {
      @page {
        size: letter landscape;
        margin: 0;
      }

      body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* 👇 CLAVE: NO forzar saltos */
      .diploma-canvas {
        page-break-after: auto;
        break-after: auto;
      }
    }
  </style>
</head>

<body>

<div class="diploma-canvas">
  <div class="border-frame">

    <!-- ENCABEZADO -->
    <div class="header">
      <div class="logo-eg-container">
        <img src="/img/Logo sin fondo 3D HD.png" class="logo-eg-img" alt="EG">
      </div>

      <div class="center-info">
        <div class="empresa-nombre"><%= empresa.nombre %></div>
        <div class="empresa-separador"></div>
        <div class="sucursal-label"><%= sucursalLabel %></div>
      </div>

      <div>
        <img src="<%= logoEmpresa %>" class="logo-cliente-img" onerror="this.style.display='none'">
      </div>
    </div>

    <!-- CUERPO -->
    <div class="contenido">
      <p style="margin:0; font-size:16px; font-family:'Montserrat'">Se otorga la presente</p>
      <h1 class="title-constancia">CONSTANCIA</h1>
      <p style="margin:0; font-size:16px; font-family:'Montserrat'">a:</p>

      <div class="recipient-wrapper">
  <div class="recipient-name"><%= participante %></div>
</div>


      <p style="font-weight:bold; margin:10px 0; font-size:20px; font-family:'Montserrat'">
        Por su participación en el curso:
      </p>

      <div class="course-text">
        Formación, organización e integración de Brigadistas de Protección Civil<br>
        <small style="font-size:16px;">
          (Primeros auxilios, combate contra incendios, búsqueda y rescate, evacuación)
        </small>
      </div>

      <div style="margin-top:15px; font-size:18px; font-family:'Montserrat'">
        Celebrado el día <strong><%= fecha.dia %></strong> de <strong><%= fecha.mes %></strong> del
        <strong><%= fecha.anio %></strong> en <strong><%= ubicacion.municipio %></strong>,
        <strong><%= ubicacion.estado %></strong>. Duración: <strong>8 horas</strong>.
      </div>
    </div>

    <!-- FIRMAS -->
    <div class="footer-signatures">
      <div></div>

      <div class="sig-block">
        <% if (capacitador.firmaUrl) { %>
          <img src="<%= capacitador.firmaUrl %>" class="sig-img">
        <% } %>
        <div class="sig-line"></div>
        <strong style="font-size:14px; font-family:'Montserrat'"><%= capacitador.nombre %></strong>
        <div style="font-size:11px; font-family:'Montserrat'">Instructor Capacitador</div>
      </div>

      <div class="sig-block">
        <img src="https://drive.google.com/thumbnail?id=1dvVupM4hcDxuLGWbasND8VK-kjGq2Kwq" class="sig-img">
        <div class="sig-line"></div>
        <strong style="font-size:14px; font-family:'Montserrat'">
          MORELOS ENRIQUE PEREZ PICOS
        </strong>
        <div style="font-size:10px; color:#c0392b; font-weight:bold; font-family:'Montserrat'">
          CONSULTOR | IEPC-SIN/CC/0128/2024
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function ajustarNombre() {
  document.querySelectorAll('.recipient-name').forEach(el => {
    el.style.transform = 'scaleX(1)';

    const wrapper = el.parentElement;
    const parentWidth = wrapper.clientWidth;
    const actualWidth = el.scrollWidth;

    if (actualWidth > parentWidth) {
      const scale = parentWidth / actualWidth;
      el.style.transform = `scaleX(${scale})`;
    }
  });
}

if (document.fonts && document.fonts.ready) {
  document.fonts.ready.then(ajustarNombre);
} else {
  window.addEventListener('load', ajustarNombre);
}

</script>

</body>
</html>
