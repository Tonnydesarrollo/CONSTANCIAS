<style>
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Montserrat:wght@400;700&family=Playfair+Display:ital,wght@1,600&display=swap');

  @media print {
    .no-print { display: none !important; }
    .diploma-canvas {
  width: 1056px;
  height: 816px;
  background-color: #fff;
}

  }

  body {
    margin: 0;
    padding: 0;
    font-family: 'Montserrat', sans-serif;
  }

  .toolbar {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 100;
  }

  .btn-save {
    background-color: #e74c3c;
    color: white;
    border: none;
    padding: 12px 25px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 4px;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
  }

  .diploma-canvas {
    width: 1123px;
    height: 794px;
    background-color: #fff;
    padding: 20px;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .border-frame {
    width: 100%;
    height: 100%;
    border: 6px solid #1a2a3a;
    outline: 2px solid #c0392b;
    outline-offset: -12px;
    padding: 25px 50px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #fff;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 180px;
    position: relative;
  }

  .logo-eg-container {
    width: 450px;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .logo-eg-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .center-info {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    text-align: center;
  }

  .client-name {
    font-family: 'Cinzel', serif;
    font-size: 22px;
    color: #1a2a3a;
    text-transform: uppercase;
  }

  .logo-cliente-img {
    max-width: 250px;
    max-height: 120px;
    object-fit: contain;
  }

  .title-constancia {
    font-family: 'Cinzel', serif;
    font-size: 60px;
    color: #1a2a3a;
    letter-spacing: 8px;
    text-align: center;
    margin: 0;
  }

  .recipient-name {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 55px;
    color: #c0392b;
    border-bottom: 2px solid #1a2a3a;
    display: inline-block;
    padding: 5px 15px;
    white-space: nowrap;
  }

  .course-text {
    width: 90%;
    margin: 5px auto;
    text-align: justify;
    text-align-last: center;
    font-size: 18px;
    line-height: 1.4;
    color: #222;
  }

  .footer-signatures {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: end;
  }

  .sig-block {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sig-line {
    width: 280px;
    border-top: 2px solid #1a2a3a;
    margin: 5px 0;
  }

  .sig-img {
    max-height: 90px;
    margin-bottom: -15px;
  }
</style>

<div class="toolbar no-print">
  <button class="btn-save" onclick="window.print()">🖨️ IMPRIMIR / GUARDAR PDF</button>
</div>

<div class="diploma-canvas">
  <div class="border-frame">

    <div class="header">
      <div class="logo-eg-container">
        <img src="https://drive.google.com/thumbnail?id=15YmFa3PwCXcZCdgzrtlFGcdIGXXF0XvL"
             class="logo-eg-img"
             alt="Desarrollo EG">
      </div>

      <div class="center-info">
        <div class="client-name"><%= empresa.nombre %></div>
        <div style="font-size: 13px; color:#666;"><%= sucursalLabel %></div>
      </div>

      <img src="<%= logoEmpresa %>" class="logo-cliente-img" alt="Logo Cliente">
    </div>

    <div style="text-align:center; flex-grow:1; display:flex; flex-direction:column; justify-content:center;">
      <p style="margin:0; font-size:16px;">Se otorga la presente</p>
      <h1 class="title-constancia">CONSTANCIA</h1>
      <p style="margin:0; font-size:16px;">a:</p>

      <div class="recipient-name"><%= participante %></div>

      <p style="font-weight:bold; margin:5px 0; font-size:16px;">
        Por su Participación en el curso:
      </p>

      <div class="course-text">
        Formación organización e Integración de Brigadistas de Protección Civil
        (Primeros auxilios, combate contra incendios, Búsqueda y Rescate, Evacuación).
      </div>

      <div style="margin-top:8px; font-size:15px;">
        Celebrado el día <strong><%= fecha.dia %></strong> de
        <strong><%= fecha.mes %></strong> del
        <strong><%= fecha.anio %></strong>
      </div>
    </div>

    <div class="footer-signatures">
      <div></div>

      <div class="sig-block">
        <% if (capacitador.firmaUrl) { %>
          <img src="<%= capacitador.firmaUrl %>" class="sig-img" alt="Firma Capacitador">
        <% } %>
        <div class="sig-line"></div>
        <strong><%= capacitador.nombre %></strong>
        <div style="font-size:11px;">Instructor Capacitador</div>
      </div>

      <div class="sig-block">
        <img src="https://drive.google.com/thumbnail?id=1dvVupM4hcDxuLGWbasND8VK-kjGq2Kwq" class="sig-img">
        <div class="sig-line"></div>
        <strong>MORELOS ENRIQUE PEREZ PICOS</strong>
        <div style="font-size:10px; color:#c0392b; font-weight:bold;">
          CONSULTOR | IEPC-SIN/CC/0128/2024
        </div>
      </div>
    </div>

  </div>
</div>
