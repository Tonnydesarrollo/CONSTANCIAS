<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Constancias de Capacitación</title>

  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      margin: 30px;
    }

    h1, h2 {
      margin-bottom: 10px;
    }

    .grupo {
      margin-bottom: 20px;
    }

    label {
      font-weight: bold;
      display: block;
      margin-bottom: 5px;
    }

    select, input[type="date"], input[type="text"] {
      padding: 6px;
      width: 320px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    table th, table td {
      border: 1px solid #ccc;
      padding: 8px;
    }

    table th {
      background: #f2f2f2;
    }

    button {
      padding: 8px 14px;
      margin-top: 10px;
      cursor: pointer;
    }

    .acciones button {
      margin-right: 10px;
    }
  </style>
</head>

<body>

  <h1>Generación de Constancias</h1>

  <!-- ================= SUCURSAL ================= -->
  <div class="grupo">
    <label>Sucursal</label>
    <h2><%= sucursal.LABEL %></h2>
  </div>

  <!-- ================= CAPACITADOR ================= -->
  <div class="grupo">
    <label>Capacitador</label>

    <%
      const listaCapacitadores = Array.isArray(capacitadores) ? capacitadores : [];
    %>

    <select id="capacitador" name="capacitador">

      <% if (capacitadorSeleccionado) { %>
        <option value="<%= capacitadorSeleccionado.ID %>" selected>
          <%= capacitadorSeleccionado.NOMBRE %>
        </option>
      <% } else { %>
        <option value="" selected>-- Selecciona capacitador --</option>
      <% } %>

      <% listaCapacitadores.forEach(emp => {
           if (!capacitadorSeleccionado || emp.ID !== capacitadorSeleccionado.ID) {
      %>
        <option value="<%= emp.ID %>">
          <%= emp.NOMBRE %>
        </option>
      <% } }) %>

    </select>
  </div>

  <!-- ================= FECHA ================= -->
  <div class="grupo">
    <label>Fecha de capacitación</label>
    <input type="date" id="fecha" value="<%= fecha %>" />
  </div>

  <!-- ================= PARTICIPANTES ================= -->
  <div class="grupo">
    <label>Participantes</label>

    <table id="tablaParticipantes">
      <thead>
        <tr>
          <th>Nombre completo</th>
          <th>Acción</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <input type="text" name="nombres[]" placeholder="Nombre del participante" />
          </td>
          <td>
            <button type="button" onclick="eliminarFila(this)">❌</button>
          </td>
        </tr>
      </tbody>
    </table>

    <button type="button" onclick="agregarFila()">➕ Agregar participante</button>
  </div>

  <!-- ================= IMPORTAR ================= -->
  <div class="grupo">
    <label>Cargar desde Excel o CSV</label>
    <input type="file" id="archivo" accept=".xlsx,.csv" />
  </div>

  <!-- ================= ACCIONES ================= -->
  <div class="grupo acciones">
    <button onclick="exportarExcel()">📥 Descargar lista en Excel</button>
    <button onclick="generarConstancias()">🚀 Generar constancias</button>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

  <script>
    function agregarFila() {
      const tbody = document.querySelector("#tablaParticipantes tbody");
      const tr = document.createElement("tr");

      tr.innerHTML = `
        <td>
          <input type="text" name="nombres[]" placeholder="Nombre del participante" />
        </td>
        <td>
          <button type="button" onclick="eliminarFila(this)">❌</button>
        </td>
      `;

      tbody.appendChild(tr);
    }

    function eliminarFila(btn) {
      btn.closest("tr").remove();
    }

    function obtenerNombres() {
      return Array.from(document.querySelectorAll('input[name="nombres[]"]'))
        .map(i => i.value)
        .filter(v => v.trim() !== "");
    }
function generarConstancias() {
  const participantes = obtenerNombres();

  if (!participantes.length) {
    alert("Debes agregar al menos un participante");
    return;
  }

  if (!document.getElementById("capacitador").value) {
    alert("Selecciona un capacitador");
    return;
  }

  fetch("/constancias/generar", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      sucursalId: "<%= sucursal.ID %>",
      capacitadorId: document.getElementById("capacitador").value,
      fecha: document.getElementById("fecha").value,
      participantes
    })
  })
  .then(r => r.text())
  .then(html => {
    const w = window.open();
    w.document.write(html);
    w.document.close();
  });
}



    function exportarExcel() {
  const nombres = obtenerNombres();

  if (!nombres.length) {
    alert("No hay participantes para exportar");
    return;
  }

  // 👉 Construimos filas para Excel
  const data = [
    ["Nombre del participante"], // encabezado
    ...nombres.map(n => [n])
  ];

  // 👉 Crear hoja y libro
  const worksheet = XLSX.utils.aoa_to_sheet(data);
  const workbook = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(workbook, worksheet, "Participantes");

  // 👉 Ajustar ancho de columna
  worksheet["!cols"] = [{ wch: 40 }];

  // 👉 Nombre del archivo
  const fecha = document.getElementById("fecha").value || "sin-fecha";
  const fileName = `participantes_${fecha}.xlsx`;

  // 👉 Descargar
  XLSX.writeFile(workbook, fileName);
}
    document.getElementById("archivo").addEventListener("change", e => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();

      reader.onload = evt => {
  const data = new Uint8Array(evt.target.result);
  const workbook = XLSX.read(data, { type: "array" });
  const sheet = workbook.Sheets[workbook.SheetNames[0]];
  const rows = XLSX.utils.sheet_to_json(sheet, { header: 1 });

  const tbody = document.querySelector("#tablaParticipantes tbody");
  tbody.innerHTML = "";

  rows.forEach((r, index) => {
    const nombre = (r[0] || "").toString().trim();

    if (index === 0) {
      const header = nombre.toLowerCase();
      if (
        header.includes("nombre") ||
        header.includes("participante") ||
        header.includes("empleado")
      ) return;
    }

    if (!nombre) return;

    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td><input type="text" name="nombres[]" value="${nombre}" /></td>
      <td><button type="button" onclick="eliminarFila(this)">❌</button></td>
    `;
    tbody.appendChild(tr);
  });

  // 👇 ESTA LÍNEA ES LA CLAVE
  document.getElementById("archivo").value = "";
};


      reader.readAsArrayBuffer(file);
    });
  </script>

</body>
</html>
